# 两台主机各自部署，用不同 S3_PREFIX；保持源目录只读挂载
BACKUP_SOURCE=/source
S3_ENDPOINT=http://YOUR-XSKY-S3-ENDPOINT
S3_BUCKET=wishfoxs-web-backup
S3_PREFIX=web-01/www/wwwroot
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
# AWS_SESSION_TOKEN=replace-me
BACKUP_TIMEOUT=2h
# 与 mysql-s3-backup 一致：五字段 cron；也支持 24h；留空仅执行一次
# cron 等待下次时间；duration 启动立即执行，之后每轮结束等待指定时间
BACKUP_INTERVAL=0 2 * * *
BACKUP_TIMEZONE=Asia/Shanghai
BACKUP_DELETE=false
BACKUP_DRY_RUN=true
