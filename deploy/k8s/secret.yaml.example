# Copy to secret.yaml and edit locally; never commit real credentials.
apiVersion: v1
kind: Secret
metadata:
  name: file-s3-backup-env
type: Opaque
stringData:
  BACKUP_SOURCE: /source
  S3_ENDPOINT: https://YOUR-XSKY-S3-ENDPOINT
  S3_BUCKET: wishfoxs-web-backup
  S3_PREFIX: mall-prod/sohu-shop/web
  AWS_REGION: us-east-1
  AWS_ACCESS_KEY_ID: replace-me
  AWS_SECRET_ACCESS_KEY: replace-me
  BACKUP_TIMEOUT: 2h
  BACKUP_INTERVAL: "0 2 * * *"
  BACKUP_TIMEZONE: Asia/Shanghai
  BACKUP_DELETE: "false"
  BACKUP_DRY_RUN: "true"
